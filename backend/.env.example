# ============================================================
#  复制为 .env 后按需修改。所有变量均以 BLOG_ 为前缀。
#  未设置时使用 app/core/config.py 中的默认值。
# ============================================================

# 服务基础信息
BLOG_APP_NAME="Glass Blog API"
BLOG_API_PREFIX="/api/v1"
BLOG_DEBUG=true

# 允许跨域的前端地址（JSON 数组写法）
# 部署时把前端生产域名追加进来，例如：
# BLOG_CORS_ORIGINS=["http://localhost:3000","https://blog.example.com"]
BLOG_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 内容数据目录，默认 backend/app/data
# BLOG_DATA_DIR="./app/data"

# 数据库地址，默认 backend/app/blog.db
# BLOG_DATABASE_URL="sqlite:///./app/blog.db"

# ============================================================
#  管理后台
#  本地开发设为 true；公网部署保持 false，只暴露只读接口。
#  密码哈希与会话密钥用下面的命令生成：
#    .venv/Scripts/python.exe scripts/hash_password.py
# ============================================================
BLOG_ADMIN_ENABLED=false
BLOG_ADMIN_PASSWORD_HASH=""
BLOG_SESSION_SECRET=""
# 登录有效期（秒），默认 12 小时
# BLOG_ADMIN_SESSION_MAX_AGE=43200
# 公网 HTTPS 部署时设为 true
# BLOG_ADMIN_COOKIE_SECURE=false

# 图片上传目录与访问前缀
# BLOG_UPLOAD_DIR="./uploads"
# BLOG_UPLOAD_URL_PREFIX="/uploads"
# 单文件上限（字节），默认 5 MB
# BLOG_UPLOAD_MAX_BYTES=5242880
# 音频上传上限（字节），默认 30 MB
# BLOG_AUDIO_UPLOAD_MAX_BYTES=31457280
# 上传接口返回 /uploads/... 相对路径，由公开站的 Next rewrite
# 与管理端的 Vite dev server 代理到后端。

# ============================================================
#  看板娘 AI 对话
#  OpenAI 兼容接口，当前默认硅基流动。换服务商只改这里。
#  key 只能放后端 .env，不要写进前端 NEXT_PUBLIC_*。
# ============================================================
BLOG_AI_BASE_URL="https://api.siliconflow.cn/v1"
BLOG_AI_API_KEY=""
BLOG_AI_MODEL="Qwen/Qwen2.5-7B-Instruct"
BLOG_AI_TIMEOUT=30
BLOG_AI_MAX_TOKENS=300
BLOG_AI_RATE_LIMIT_PER_MINUTE=10